{
  "schema": "proof.liskov.application-manifest",
  "schemaVersion": 4,
  "applicationId": "liskov-runtime-images-v5-canary",
  "metadata": {
    "appType": "background-worker",
    "description": "Bounded Acurast candidate canary for the OCI-derived, PRoot-Distro v5-compatible Debian Trixie Liskov rootfs.",
    "labels": [
      "liskov",
      "runtime-image",
      "canary",
      "debian-trixie",
      "helperless-rc12",
      "proot-v5-compatible"
    ]
  },
  "release": {
    "mode": "pinned",
    "artifact": {
      "kind": "runtime_image",
      "imageDigest": "sha256:0639e88db6b46cef6091acafe35dfb1b59c5e354463d969f1a9509451d118377",
      "bootstrapCid": "ipfs://QmaKDyYkqrMRjZZy4Nh6g9Z9AcaiZ84NkqRvPRp8W7jvpF",
      "bootstrapDigest": "sha256:ed37d63722ee734a5ff5c9466ef0454b610ab4a27e5ff1dceafc7d634267aeab"
    }
  },
  "runtime": {
    "command": "/bin/sh -c 'echo liskov-runtime-images-debian-trixie-helperless-rc12-final-handoff; exec sleep 420'",
    "maxGenerations": 1,
    "role": "runtime-image-canary",
    "resources": {
      "memoryMiB": 128,
      "storageMiB": 256,
      "networkRequestQuota": 0
    },
    "requiredModules": [
      "Shell"
    ],
    "bootstrap": {
      "trustProfile": "proof.liskov.attested-runtime.v1",
      "signedDiagnosticsRequired": true,
      "identityBoundSecretsRequired": true
    }
  },
  "deployment": {
    "parallelism": 1,
    "schedule": {
      "durationMs": 900000,
      "startDelayMs": 300000,
      "maxStartDelayMs": 300000
    },
    "placement": {
      "requirements": {
        "trustProfile": "proof.liskov.attested-runtime.v1"
      },
      "processorSelection": {
        "mode": "manager",
        "managerId": "9470",
        "requireScheduleClear": true,
        "requireConsumerAccess": true,
        "candidateLimit": 16
      }
    },
    "lifecycle": {
      "renewal": {
        "mode": "before_scheduled_end",
        "leadTime": {
          "mode": "fixed",
          "durationMs": 60000
        }
      },
      "update": {
        "timing": "immediate",
        "existingJobs": {
          "mode": "run_until_scheduled_end"
        }
      },
      "recovery": {
        "launch": {
          "maxRetries": 0
        },
        "runtimeFailure": {
          "mode": "wait_until_scheduled_end"
        }
      }
    },
    "spend": {
      "maxRewardPlanckPerJob": "40000000000",
      "maxNativeFeePlanckPerJob": "10000000000"
    }
  },
  "ingress": {},
  "observability": {
    "logs": {
      "enabled": false
    },
    "runtimeDiagnostics": {
      "signed": true
    }
  },
  "configuration": {}
}
